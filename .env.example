# ---- Obligatoire ----
DASH_PASSWORD=choisis-un-mot-de-passe-long        # protège le tableau de bord (données clients)

# ---- Tout le reste se configure DEPUIS L'APPLI ----
# Ouvre le site, va dans Agent -> Intégrations : colle ta clé Claude, ton jeton Instagram/Facebook,
# ton jeton WhatsApp. L'URL publique et l'adresse du webhook y sont détectées automatiquement.
# Les variables ci-dessous ne servent que si tu préfères tout gérer par variables d'environnement,
# ou pour les modèles WhatsApp (approuvés par Meta), qui eux restent ici :

# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5                     # moins cher : claude-haiku-4-5-20251001
# META_VERIFY_TOKEN=...
# META_APP_SECRET=...
# META_PAGE_TOKEN=...
# IG_TOKEN=...                                     # seulement si tu utilises la connexion Instagram directe
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_ID=...
# OWNER_WA=216XXXXXXXX
# PUBLIC_URL=https://ton-domaine.com                # sinon détectée automatiquement depuis les requêtes

# Modèles WhatsApp approuvés par Meta (catégorie Utilitaire) : uniquement en variable d'environnement.
# WA_ALERT_TEMPLATE={"name":"alerte_wakil","lang":"fr"}
# WA_EXPORT_TEMPLATE={"name":"export_quotidien","lang":"fr"}
# WA_TEMPLATES={"demande":{"name":"confirmation_demande","lang":"ar","params":["prenom","boutique","produit","montant"]},"confirmee":{"name":"commande_confirmee","lang":"ar","params":["prenom","numero"]},"emballee":{"name":"commande_emballee","lang":"ar","params":["numero"]},"en_livraison":{"name":"commande_en_livraison","lang":"ar","params":["numero","date_estimee","montant"]},"livree":{"name":"commande_livree","lang":"ar","params":["prenom","boutique"]}}

# ---- Réglages ----
EXPORT_HOUR=20                                     # heure d'envoi de l'Excel du soir
DATA_DIR=./data                                    # sur Railway/Render : dossier d'un volume persistant
PORT=3000
